{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rebroad.github.io/tidewater/schemas/world-source.schema.json",
  "title": "ElseMesh ThruHold World Source",
  "description": "Shared authoring document exchanged by the AI editor service and Blender tools. This is unsigned source data, not a publishable server manifest.",
  "type": "object",
  "required": [
    "protocol",
    "worldId",
    "title",
    "coordinateSystem",
    "styleGuide",
    "rules",
    "objects",
    "portals",
    "updatedAt"
  ],
  "properties": {
    "protocol": {
      "const": "tidewater.world-source/1"
    },
    "worldId": {
      "type": "string",
      "pattern": "^tw-world:[\\w.-]{1,128}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "experience": {
      "type": "object",
      "description": "Optional ThruHold-specific game identity and loading-page copy. All strings are rendered as text, never markup.",
      "required": ["genre", "tagline", "loadingNote", "tips", "stages"],
      "properties": {
        "genre": { "type": "string", "minLength": 1, "maxLength": 240 },
        "tagline": { "type": "string", "minLength": 1, "maxLength": 240 },
        "loadingNote": { "type": "string", "minLength": 1, "maxLength": 240 },
        "tips": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 320 } },
        "stages": {
          "type": "object",
          "maxProperties": 12,
          "propertyNames": { "enum": ["gpu", "atmosphere", "terrain", "village", "vegetation", "ocean", "reef", "simulation", "shaders", "world", "compile", "warmup"] },
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      },
      "additionalProperties": false
    },
    "spawn": {
      "type": "object",
      "description": "Initial camera eye pose in world-space meters; yaw and pitch in radians. Omission uses the legacy entrance.",
      "required": ["position", "yaw", "pitch"],
      "properties": {
        "position": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number", "minimum": -1000000, "maximum": 1000000 } },
        "yaw": { "type": "number", "minimum": -360, "maximum": 360 },
        "pitch": { "type": "number", "minimum": -1.5, "maximum": 1.5 }
      },
      "additionalProperties": false
    },
    "coordinateSystem": {
      "const": "right-handed-y-up-meters"
    },
    "styleGuide": {
      "type": "string",
      "maxLength": 10000
    },
    "rules": {
      "type": "object",
      "required": [
        "gravity",
        "avatarComplexity",
        "physicsProfile"
      ],
      "properties": {
        "gravity": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 2
        },
        "seaLevel": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000,
          "description": "Optional world-space Y coordinate in meters for the sea surface. Omission means the world does not declare a sea level."
        },
        "atmosphereLevel": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000,
          "description": "Optional world-space Y coordinate in meters for the upper atmosphere boundary. Omission means the world does not declare an atmosphere boundary."
        },
        "avatarComplexity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "physicsProfile": {
          "type": "string",
          "enum": ["default", "tidewater-default"]
        },
        "movement": {
          "type": "object",
          "required": ["walkSpeed", "sprintSpeed", "jumpSpeed"],
          "properties": {
            "walkSpeed": { "type": "number", "minimum": 0.5, "maximum": 10 },
            "sprintSpeed": { "type": "number", "minimum": 0.5, "maximum": 15 },
            "jumpSpeed": { "type": "number", "minimum": 0, "maximum": 10 }
          },
          "additionalProperties": false
        },
        "vehiclePolicy": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "maxSpeed": { "type": "number", "minimum": 0.5, "maximum": 16 },
            "maxCombinedComplexity": { "type": "integer", "minimum": 1, "maximum": 1000000 }
          },
          "allOf": [
            { "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] }, "then": { "required": ["maxSpeed", "maxCombinedComplexity"] } },
            { "if": { "properties": { "enabled": { "const": false } }, "required": ["enabled"] }, "then": { "not": { "anyOf": [{ "required": ["maxSpeed"] }, { "required": ["maxCombinedComplexity"] }] } } }
          ],
          "additionalProperties": false,
          "description": "Optional destination acceptance for the built-in Downeast boat. Accepted transfers apply maxSpeed and require configured avatar complexity plus the bundled boat's triangle count to fit maxCombinedComplexity. Omission or enabled=false denies vehicle transfer and suppresses open-portal previews while the player is aboard or at the helm."
        },
        "maxPackageBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 17179869184,
          "description": "Optional aggregate size limit for all unique world assets, in bytes. Conversion, node validation, and the browser enforce the limit before publication or download."
        },
        "requiredFeatures": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 96,
            "pattern": "^tidewater\\.[a-z0-9.-]+/\\d+$"
          }
        }
      },
      "additionalProperties": true
    },
    "hosts": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/hostGrant" }
    },
    "objects": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/object"
      }
    },
    "components": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/component" }
    },
    "portals": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/portal"
      }
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [{"if": {"properties": {"portals": {"contains": {"required": ["back"]}}}, "required": ["portals"]}, "then": {"properties": {"rules": {"required": ["requiredFeatures"], "properties": {"requiredFeatures": {"contains": {"const": "tidewater.portal-two-sided/1"}}}}}}}],
  "$defs": {
    "vector3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "streamingBounds": {
      "type": "object",
      "description": "Optional world-space bounding sphere used for view- and distance-driven component data requests.",
      "required": ["center", "radius"],
      "properties": {
        "center": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number", "minimum": -10000, "maximum": 10000 } },
        "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000 }
      },
      "additionalProperties": false
    },
    "transform": {
      "type": "object",
      "required": [
        "position",
        "yaw"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/vector3"
        },
        "yaw": {
          "type": "number"
        },
        "rotation": {
          "type": "array",
          "description": "Optional normalized [x,y,z,w] quaternion for collision-free asset instances.",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number" }
        }
      },
      "additionalProperties": true
    },
    "hostGrant": {
      "type": "object",
      "required": ["peerId", "scopes", "expiresAt", "epoch"],
      "properties": {
        "peerId": { "type": "string", "minLength": 20, "maxLength": 256, "pattern": "^[A-Za-z0-9]+$" },
        "scopes": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["content-cache", "failover-authority"] } },
        "expiresAt": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "epoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "failoverAfter": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "failoverSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
      },
      "allOf": [
        {
          "if": { "properties": { "scopes": { "contains": { "const": "failover-authority" } } }, "required": ["scopes"] },
          "then": { "required": ["failoverAfter", "failoverSeconds"] },
          "else": { "not": { "anyOf": [ { "required": ["failoverAfter"] }, { "required": ["failoverSeconds"] } ] } }
        }
      ],
      "additionalProperties": false
    },
    "object": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "label",
        "assetId",
        "transform",
        "scale",
        "collision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^tw-object:[\\w.-]{1,128}$"
        },
        "kind": {
          "const": "asset-instance"
        },
        "label": {
          "type": "string",
          "maxLength": 160
        },
        "assetId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "scale": {
          "$ref": "#/$defs/vector3"
        },
        "streamingBounds": {
          "type": "object",
          "description": "Optional object-local bounding sphere used for view- and distance-driven asset requests.",
          "required": ["center", "radius"],
          "properties": {
            "center": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": { "type": "number", "minimum": -10000, "maximum": 10000 }
            },
            "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000 }
          },
          "additionalProperties": false
        },
        "collision": {
          "type": "object",
          "required": ["shape", "enabled"],
          "properties": {
            "shape": { "enum": ["box", "compound", "heightfield", "none"] },
            "enabled": { "type": "boolean" },
            "center": { "$ref": "#/$defs/vector3" },
            "halfExtents": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 }
            },
            "boxes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2048,
              "items": {
                "type": "object",
                "required": ["center", "halfExtents", "yaw", "walkable", "solid"],
                "properties": {
                  "center": { "$ref": "#/$defs/vector3" },
                  "halfExtents": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 }
                  },
                  "yaw": { "type": "number", "minimum": -360, "maximum": 360 },
                  "walkable": { "type": "boolean" },
                  "solid": { "type": "boolean" }
                },
                "additionalProperties": false
              }
            },
            "walkable": { "type": "boolean" },
            "solid": { "type": "boolean" },
            "columns": { "type": "integer", "minimum": 2, "maximum": 4097 },
            "rows": { "type": "integer", "minimum": 2, "maximum": 4097 }
          },
          "additionalProperties": true
        },
        "priority": {
          "type": "string",
          "enum": [
            "portal-preview",
            "visible",
            "nearby",
            "background"
          ]
        },
        "replacesObjectId": {
          "type": "string",
          "pattern": "^tw-object:[\\w.-]{1,128}$",
          "description": "A higher-detail object that replaces a non-colliding portal-preview object after its asset loads."
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": { "collision": { "properties": { "enabled": { "const": true } } } }
          },
          "then": {
            "properties": {
              "collision": {
                "oneOf": [
                  { "required": ["shape", "center", "halfExtents", "walkable", "solid"], "properties": { "shape": { "const": "box" } } },
                  { "required": ["shape", "boxes"], "properties": { "shape": { "const": "compound" } } },
                  { "required": ["shape", "columns", "rows", "walkable", "solid"], "properties": { "shape": { "const": "heightfield" }, "walkable": { "const": true }, "solid": { "const": true } } }
                ]
              }
            }
          }
        }
      ]
    },
    "component": {
      "type": "object",
      "oneOf": [
        {
          "required": ["id", "type", "seed"],
          "properties": {
            "id": { "type": "string", "pattern": "^tw-component:[\\w.-]{1,128}$" },
            "type": { "const": "tidewater.procedural-island-vegetation/1" },
            "seed": { "const": 7 },
            "priority": { "enum": ["portal-preview", "visible", "nearby", "background"] },
            "placementAssetId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "streamingBounds": { "$ref": "#/$defs/streamingBounds" }
          },
          "additionalProperties": false
        },
        {
          "required": ["id", "type"],
          "properties": {
            "id": { "type": "string", "pattern": "^tw-component:[\\w.-]{1,128}$" },
            "type": { "const": "tidewater.island-ocean/1" },
            "priority": { "enum": ["portal-preview", "visible", "nearby", "background"] },
            "streamingBounds": { "$ref": "#/$defs/streamingBounds" }
          },
          "additionalProperties": false
        },
        {
          "required": ["id", "type", "profile", "objectId"],
          "properties": {
            "id": { "type": "string", "pattern": "^tw-component:[\\w.-]{1,128}$" },
            "type": { "const": "tidewater.procedural-island-terrain/1" },
            "profile": { "const": "example-island-v1" },
            "objectId": { "type": "string", "pattern": "^tw-object:[\\w.-]{1,128}$", "description": "References the package heightfield mesh used for collision and visual fallback." },
            "priority": { "enum": ["portal-preview", "visible", "nearby", "background"] },
            "streamingBounds": { "$ref": "#/$defs/streamingBounds" }
          },
          "additionalProperties": false
        },
        {
          "required": ["id", "type", "profile", "objectId", "dataAssetId"],
          "properties": {
            "id": { "type": "string", "pattern": "^tw-component:[\\w.-]{1,128}$" },
            "type": { "const": "tidewater.terrain-surface/1" },
            "profile": { "const": "example-island-v1" },
            "objectId": { "type": "string", "pattern": "^tw-object:[\\w.-]{1,128}$", "description": "References the heightfield mesh used for collision and visual fallback." },
            "dataAssetId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "References portable height, normal, AO, terrain masks, detail texture, and terrain metadata." },
            "priority": { "enum": ["portal-preview", "visible", "nearby", "background"] },
            "streamingBounds": { "$ref": "#/$defs/streamingBounds" }
          },
          "additionalProperties": false
        },
        {
          "required": ["id", "type", "center", "extent"],
          "properties": {
            "id": { "type": "string", "pattern": "^tw-component:[\\w.-]{1,128}$" },
            "type": { "const": "tidewater.water-body/1" },
            "center": { "type": "array", "items": { "type": "number", "minimum": -1000000, "maximum": 1000000 }, "minItems": 2, "maxItems": 2, "description": "Horizontal world-space [x,z] center in meters." },
            "extent": { "type": "number", "minimum": 8, "maximum": 100000, "description": "Half-width and half-depth of a square deep-water body, in meters." },
            "profile": { "enum": ["deep-ocean", "calm-lagoon", "storm"], "description": "Optional named rendering profile; omission selects deep-ocean." },
            "priority": { "enum": ["portal-preview", "visible", "nearby", "background"] },
            "streamingBounds": { "$ref": "#/$defs/streamingBounds" }
          },
          "additionalProperties": false
        },
        {
          "required": ["id", "type", "placementAssetId"],
          "properties": {
            "id": { "type": "string", "pattern": "^tw-component:[\\w.-]{1,128}$" },
            "type": { "const": "tidewater.static-vegetation/1" },
            "priority": { "enum": ["portal-preview", "visible", "nearby", "background"] },
            "placementAssetId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "streamingBounds": { "$ref": "#/$defs/streamingBounds" }
          },
          "additionalProperties": false
        },
        {
          "required": ["id", "type", "placementAssetId", "streamingBounds"],
          "properties": {
            "id": { "type": "string", "pattern": "^tw-component:[\\w.-]{1,128}$" },
            "type": { "const": "tidewater.static-reef/1" },
            "priority": { "enum": ["portal-preview", "visible", "nearby", "background"] },
            "placementAssetId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "streamingBounds": { "$ref": "#/$defs/streamingBounds" }
          },
          "additionalProperties": false
        },
        {
          "required": ["id", "type", "beds"],
          "properties": {
            "id": { "type": "string", "pattern": "^tw-component:[\\w.-]{1,128}$" },
            "type": { "const": "tidewater.ambient-audio/1" },
            "priority": { "enum": ["portal-preview", "visible", "nearby", "background"] },
            "streamingBounds": { "$ref": "#/$defs/streamingBounds" },
            "beds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object",
                "required": ["assetId", "gain"],
                "properties": {
                  "assetId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                  "gain": { "type": "number", "minimum": 0, "maximum": 1 },
                  "condition": { "enum": ["always", "day", "night", "dawn", "underwater"] },
                  "position": { "type": "array", "items": { "type": "number", "minimum": -100000, "maximum": 100000 }, "minItems": 3, "maxItems": 3 },
                  "refDistance": { "type": "number", "minimum": 0.5, "maximum": 1000 },
                  "rolloff": { "type": "number", "minimum": 0, "maximum": 10 }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["id", "type", "objectId", "priority"],
          "properties": {
            "id": { "type": "string", "pattern": "^tw-component:[\\w.-]{1,128}$" },
            "type": { "const": "tidewater.downeast-boat/1" },
            "objectId": { "type": "string", "pattern": "^tw-object:[\\w.-]{1,128}$", "description": "References a collision-free portal-preview asset instance. Its transform defines the trusted built-in boat's berth and heading." },
            "priority": { "const": "portal-preview" }
          },
          "additionalProperties": false
        }
      ]
    },
    "portalBack": {
      "type": "object",
      "required": [
        "destinationWorldId",
        "exit",
        "openView",
        "enabled"
      ],
      "properties": {
        "destinationWorldId": {
          "type": "string",
          "pattern": "^tw-world:[\\w.-]{1,128}$"
        },
        "destinationPeerId": {
          "type": "string",
          "minLength": 20,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9]+$",
          "description": "Optional provider identity. Omit it to discover world providers by destinationWorldId."
        },
        "destinationGateway": {
          "type": "string",
          "format": "uri",
          "description": "Optional HTTPS or WSS origin for the destination node's browser gateway.",
          "pattern": "^(https|wss)://[^/?#]+/?$"
        },
        "exit": {
          "type": "object",
          "required": [
            "position",
            "yaw"
          ],
          "properties": {
            "position": {
              "$ref": "#/$defs/vector3"
            },
            "yaw": {
              "type": "number",
              "minimum": -360,
              "maximum": 360
            }
          },
          "additionalProperties": false
        },
        "openView": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "description": "Independent rear connection. Uses the same entry position and entry yaw plus PI radians. Omission preserves the legacy portal behavior. Requires rules.requiredFeatures to include tidewater.portal-two-sided/1."
    },
    "portal": {
      "type": "object",
      "required": [
        "id",
        "destinationWorldId",
        "entry",
        "exit",
        "openView",
        "enabled"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^tw-portal:[\\w.-]{1,128}$"
        },
        "destinationWorldId": {
          "type": "string",
          "pattern": "^tw-world:[\\w.-]{1,128}$"
        },
        "destinationPeerId": {
          "type": "string",
          "minLength": 20,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9]+$",
          "description": "Optional provider identity. Omit it to discover world providers by destinationWorldId."
        },
        "destinationGateway": {
          "type": "string",
          "format": "uri",
          "description": "Optional HTTPS or WSS origin for the destination node's browser gateway.",
          "pattern": "^(https|wss)://[^/?#]+/?$"
        },
        "entry": {
          "$ref": "#/$defs/transform"
        },
        "exit": {
          "$ref": "#/$defs/transform"
        },
        "openView": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "back": { "$ref": "#/$defs/portalBack" },
        "visual": {
          "type": "string",
          "enum": ["timber", "stone", "metal"],
          "description": "Optional client-rendered doorway frame material. Omit to render no frame."
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
